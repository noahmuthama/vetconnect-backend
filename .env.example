# Runtime environment
APP_NAME=VetConnect API
ENVIRONMENT=development

# Local SQLite example; use postgresql+psycopg://... in staging/production
DATABASE_URL=sqlite:///./vet_connect.db

# Replace with a long random value outside local development
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins are parsed by your deployment environment or shell.
# For direct .env usage, set a JSON list if your settings loader is extended.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_NEARBY_RADIUS_KM=100
RATE_LIMIT_PER_MINUTE=60
